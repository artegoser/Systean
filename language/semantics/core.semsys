type Entity;
type Occurrence;
type Event;
type Process;
type State;
type Activity;
subtype Event: Occurrence;
subtype Process: Occurrence;
subtype State: Occurrence;
subtype Activity: Occurrence;
type Proposition;
type Number;
type Boolean;
type Text;
type Utterance;
type SpeechAct;
type Affect;
type Digit;
type DigitSequence;
type Sequence<T>;
type Unit<D>;
type Quantity<D>;
type Approximate<T>;
type LengthDimension;
type TimeDimension;
type MassDimension;
type TemperatureDimension;
type CurrentDimension;
type AmountDimension;
type LuminousIntensityDimension;
type Temporal;
type Instant;
type Interval;
type Duration;
type CalendarDate;
type TimeOfDay;
type TimeZone;
subtype Instant: Temporal;
subtype Interval: Temporal;
subtype CalendarDate: Temporal;
subtype TimeOfDay: Temporal;
literal integer: Number;
literal boolean: Boolean;
literal string: Text;
operator before(left: Temporal, right: Temporal) -> Proposition;
operator after(left: Temporal, right: Temporal) -> Proposition;
operator during(value: Temporal, interval: Interval) -> Proposition;
operator interval(start: Instant, end: Instant) -> Interval;
operator duration_of(interval: Interval, duration: Duration) -> Proposition;
operator time_value(value: Temporal) -> Proposition;
operator proper_name(payload: Text) -> Entity;
operator and(left: Proposition, right: Proposition) -> Proposition;
operator or(left: Proposition, right: Proposition) -> Proposition;
operator not(value: Proposition) -> Proposition;
operator implies(condition: Proposition, consequence: Proposition) -> Proposition;
operator forall(predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator exists(predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator exactly(count: Number, predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator at_least(count: Number, predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator at_most(count: Number, predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator event_of(content: Proposition) -> Event;
operator process_of(content: Proposition) -> Process;
operator state_of(content: Proposition) -> State;
operator activity_of(content: Proposition) -> Activity;
operator cease(target: Occurrence) -> Proposition;
operator start(target: Occurrence) -> Proposition;
operator continue(target: Occurrence) -> Proposition;
operator finish(target: Occurrence) -> Proposition;
operator interrupt(target: Occurrence) -> Proposition;
operator habitual(activity: Occurrence) -> Activity;
operator repeat(target: Occurrence, count: Number) -> Activity;
operator set_pair(left: Entity, right: Entity) -> Entity;
operator list_pair(first: Entity, second: Entity) -> Entity;
operator group_pair(left: Entity, right: Entity) -> Entity;
operator collective(content: Proposition) -> Proposition;
operator distributive(content: Proposition) -> Proposition;
operator association(left: Entity, right: Entity) -> Proposition;
operator counterfactual(condition: Proposition, consequence: Proposition) -> Proposition;
operator typical(domain: Entity, measure: Entity, standard: Number) -> Proposition;
operator statistical(domain: Entity, measure: Entity, value: Number) -> Proposition;
operator probability(claim: Proposition, value: Number) -> Proposition;
operator frequency(activity: Activity, measure: Entity, value: Number) -> Proposition;
operator equal<T>(left: $T, right: $T) -> Proposition;
operator ask_truth(content: Proposition) -> Utterance;
operator command(content: Proposition) -> Utterance;
operator request(content: Proposition) -> Utterance;

operator person(entity: Entity) -> Proposition;
operator animal(entity: Entity) -> Proposition;
operator location(entity: Entity) -> Proposition;
operator physical_object(entity: Entity) -> Proposition;
operator text_value(value: Text) -> Proposition;
operator language_entity(entity: Entity) -> Proposition;
operator name_text(value: Text) -> Proposition;
operator see(observer: Entity, observed: Entity) -> Proposition;
operator hear(observer: Entity, heard: Entity) -> Proposition;
operator move(mover: Entity) -> Proposition;
operator arrive(mover: Entity, target: Entity) -> Proposition;
operator go_toward(mover: Entity, destination: Entity) -> Proposition;
operator give(giver: Entity, item: Entity, recipient: Entity) -> Proposition;
operator hold(holder: Entity, held: Entity) -> Proposition;
operator possess(possessor: Entity, possessed: Entity) -> Proposition;
operator create(creator: Entity, product: Entity) -> Proposition;
operator alive(entity: Entity) -> Proposition;
operator die(entity: Entity) -> Proposition;
operator new_relative(value: Entity, standard: Entity) -> Proposition;
operator old_relative(value: Entity, standard: Entity) -> Proposition;
operator positive_by(value: Entity, criterion: Entity) -> Proposition;
operator negative_by(value: Entity, criterion: Entity) -> Proposition;
operator truth(value: Proposition) -> Proposition;
operator falsity(value: Proposition) -> Proposition;
operator similar_by(left: Entity, right: Entity, dimension: Entity) -> Proposition;
operator different_by(left: Entity, right: Entity, dimension: Entity) -> Proposition;
operator equal_by(left: Entity, right: Entity, dimension: Entity) -> Proposition;
operator greater_by(left: Entity, right: Entity, dimension: Entity) -> Proposition;
operator less_by(left: Entity, right: Entity, dimension: Entity) -> Proposition;
operator inside(value: Entity, container: Entity) -> Proposition;
operator above(value: Entity, reference: Entity) -> Proposition;
operator below(value: Entity, reference: Entity) -> Proposition;
operator near_by(value: Entity, reference: Entity, standard: Entity) -> Proposition;
operator far_by(value: Entity, reference: Entity, standard: Entity) -> Proposition;
operator know(knower: Entity, content: Proposition) -> Proposition;
operator believe(believer: Entity, content: Proposition) -> Proposition;
operator remember(rememberer: Entity, content: Proposition) -> Proposition;
operator think(thinker: Entity, content: Proposition) -> Proposition;
operator speak(speaker: Entity, content: Text) -> Proposition;
operator write(writer: Entity, content: Text) -> Proposition;
