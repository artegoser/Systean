// Phase 18 normative lexical semantic declarations.
// The Systean root itself is the semantic symbol identity.

word sol : Entity;
word ref<T> : $T = meta.resolve();
word mi : Entity = speaker;
word tu : Entity = addressee;
word na($payload: Text) -> Entity {
    form _ $payload;
    capture $payload bare;
}
word ke($content: Proposition) -> Utterance {
    form _ $content;
    outer;
}
word ne($value: Proposition) -> Proposition = logic.not($value) {
    form _ $value;
}
word va($left: Proposition, $right: Proposition) -> Proposition = logic.and($left, $right) {
    form $left _ $right;
    precedence 20;
    associative;
}
word zo($left: Proposition, $right: Proposition) -> Proposition = logic.or($left, $right) {
    form $left _ $right;
    precedence 10;
    associative;
}
word ra($predicate: fn(value: Entity) -> Proposition) -> Proposition {
    form _ @restriction;
    bind $predicate using imp;
}
word mu($predicate: fn(value: Entity) -> Proposition) -> Proposition {
    form _ @restriction;
    bind $predicate using va;
}
word da($content: Proposition) -> Utterance {
    form _ $content;
    outer;
}
word me($content: Proposition) -> Utterance {
    form _ $content;
    outer;
}
word per($entity: Entity) -> Proposition;
word anim($entity: Entity) -> Proposition;
word lok($entity: Entity) -> Proposition;
word obj($entity: Entity) -> Proposition;
word vid($observer: Entity, $observed: Entity) -> Proposition;
word aud($observer: Entity, $heard: Entity) -> Proposition;
word mov($mover: Entity) -> Proposition;
word ven($mover: Entity, $target: Entity) -> Proposition;
word vad($mover: Entity, $destination: Entity) -> Proposition;
word don($giver: Entity, $item: Entity, $recipient: Entity) -> Proposition;
word ten($holder: Entity, $held: Entity) -> Proposition;
word hab($possessor: Entity, $possessed: Entity) -> Proposition;
word fak($creator: Entity, $product: Entity) -> Proposition;
word viv($entity: Entity) -> Proposition;
word mor($entity: Entity) -> Proposition;
word nov($value: Entity, $standard: Entity) -> Proposition;
word vet($value: Entity, $standard: Entity) -> Proposition;
word bon($value: Entity, $criterion: Entity) -> Proposition;
word mal($value: Entity, $criterion: Entity) -> Proposition;
word ver($value: Proposition) -> Proposition {
    form _ $value;
}
word fal($value: Proposition) -> Proposition {
    form _ $value;
}
word sim($left: Entity, $right: Entity, $dimension: Entity) -> Proposition;
word dif($left: Entity, $right: Entity, $dimension: Entity) -> Proposition;
word par($left: Entity, $right: Entity, $dimension: Entity) -> Proposition;
word mag($left: Entity, $right: Entity, $dimension: Entity) -> Proposition;
word min($left: Entity, $right: Entity, $dimension: Entity) -> Proposition;
word in($value: Entity, $container: Entity) -> Proposition;
word sur($value: Entity, $reference: Entity) -> Proposition;
word sub($value: Entity, $reference: Entity) -> Proposition;
word prok($value: Entity, $reference: Entity, $standard: Entity) -> Proposition;
word dist($value: Entity, $reference: Entity, $standard: Entity) -> Proposition;
word zna($knower: Entity, $content: Proposition) -> Proposition;
word bel($believer: Entity, $content: Proposition) -> Proposition;
word mem($rememberer: Entity, $content: Proposition) -> Proposition;
word dum($thinker: Entity, $content: Proposition) -> Proposition;
word nom($value: Text) -> Proposition;
word tekst($value: Text) -> Proposition;
word ling($entity: Entity) -> Proposition;
word gov($speaker: Entity, $content: Text) -> Proposition;
word skrib($writer: Entity, $content: Text) -> Proposition;
word nau : Instant = now;
word ante($left: Temporal, $right: Temporal) -> Proposition;
word aft($left: Temporal, $right: Temporal) -> Proposition;
word pot($value: Temporal, $interval: Interval) -> Proposition;
word temp($value: Temporal) -> Proposition;
word sta($target: Occurrence) -> Proposition {
    form _ $target;
}
word stop($target: Occurrence) -> Proposition {
    form _ $target;
}
word dur($target: Occurrence) -> Proposition {
    form _ $target;
}
word fin($target: Occurrence) -> Proposition {
    form _ $target;
}
word rup($target: Occurrence) -> Proposition {
    form _ $target;
}
word reg($activity: Occurrence) -> Activity {
    form _ $activity;
}
word rep($target: Occurrence, $count: Number) -> Activity;
word unk<T>($knower: Entity) -> $T = meta.hole(InfoMode.unknown($knower)) {
    form _ $knower;
}
word vak<T> : $T = meta.hole(InfoMode.unspecified);
word hid<T> : $T = meta.hole(InfoMode.withheld);
word rov($count: Number, $predicate: fn(value: Entity) -> Proposition) -> Proposition {
    form _ $count @restriction;
    bind $predicate using va;
}
word mini($count: Number, $predicate: fn(value: Entity) -> Proposition) -> Proposition {
    form _ $count @restriction;
    bind $predicate using va;
}
word maks($count: Number, $predicate: fn(value: Entity) -> Proposition) -> Proposition {
    form _ $count @restriction;
    bind $predicate using va;
}
word set($left: Entity, $right: Entity) -> Entity;
word list($first: Entity, $second: Entity) -> Entity;
word grup($left: Entity, $right: Entity) -> Entity;
word kol($content: Proposition) -> Proposition {
    form _ $content;
}
word dis($content: Proposition) -> Proposition {
    form _ $content;
}
word aso($left: Entity, $right: Entity) -> Proposition;
word imp($condition: Proposition, $consequence: Proposition) -> Proposition {
    form $condition _ $consequence;
    precedence 5;
}
word hip($condition: Proposition, $consequence: Proposition) -> Proposition {
    form $condition _ $consequence;
    precedence 5;
}
word tip($domain: Entity, $measure: Entity, $standard: Number) -> Proposition;
word stat($domain: Entity, $measure: Entity, $value: Number) -> Proposition;
word prob($claim: Proposition, $value: Number) -> Proposition;
word frek($activity: Activity, $measure: Entity, $value: Number) -> Proposition;
word emo($state: SubjectiveExperience) -> Utterance {
    form _ $state;
    outer;
}
word fok<T>($target: $T, $content: Proposition) -> Utterance {
    form $target _ $content;
    precedence 2;
    outer;
}
word top<T>($target: $T, $content: Proposition) -> Utterance {
    form $target _ $content;
    precedence 2;
    outer;
}
word ret($target: Number) -> Utterance {
    form _ $target;
    outer;
}
word kor($target: Number, $replacement: Proposition) -> Utterance {
    form $target _ $replacement;
    precedence 1;
    outer;
}
word klar($target: Number, $content: Proposition) -> Utterance {
    form $target _ $content;
    precedence 1;
    outer;
}
word felis($experiencer: Entity, $intensity: Number) -> Affect;
word satis($experiencer: Entity, $target: Proposition, $intensity: Number) -> Affect;
