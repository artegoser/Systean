{
	"name": "site",
	"version": "0.0.1",
	"scripts": {
		"wasm:build": "../scripts/build-wasm.sh",
		"dev": "pnpm wasm:build && vite dev",
		"build": "pnpm wasm:build && vite build",
		"preview": "vite preview",
		"check": "pnpm wasm:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm wasm:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "6.0.1",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@tailwindcss/postcss": "^4.1.7",
		"@types/eslint": "^9.6.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "10.1.5",
		"eslint-plugin-svelte": "3.7.0",
		"globals": "16.1.0",
		"postcss": "^8.4.41",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.7",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.0.0",
		"vite": "6.3.5"
	},
	"type": "module"
}
