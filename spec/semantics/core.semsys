type Entity;
type Occurrence;
type Event;
type Process;
type State;
type Activity;
subtype Event: Occurrence;
subtype Process: Occurrence;
subtype State: Occurrence;
subtype Activity: Occurrence;
type Proposition;
type Number;
type Boolean;
type Text;
type Utterance;
type SpeechAct;
type Affect;
type Digit;
type DigitSequence;
type Sequence<T>;
literal integer: Number;
literal boolean: Boolean;
literal string: Text;
operator and(left: Proposition, right: Proposition) -> Proposition;
operator or(left: Proposition, right: Proposition) -> Proposition;
operator not(value: Proposition) -> Proposition;
operator implies(condition: Proposition, consequence: Proposition) -> Proposition;
operator forall(predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator exists(predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator cease(target: Occurrence) -> Proposition;
operator start(target: Occurrence) -> Proposition;
operator continue(target: Occurrence) -> Proposition;
operator finish(target: Occurrence) -> Proposition;
operator interrupt(target: Occurrence) -> Proposition;
operator habitual(activity: Activity) -> Activity;
operator repeat(target: Occurrence, count: Number) -> Activity;
operator equal<T>(left: $T, right: $T) -> Proposition;
