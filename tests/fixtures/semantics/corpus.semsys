type Information;
type Group<T>;
operator occurs(occurrence: Occurrence) -> Proposition;
operator resting(entity: Entity) -> State;
operator eating(agent: Entity, object: Entity) -> Process;
operator arrival(agent: Entity, destination: Entity) -> Event;
operator group_lift(group: Group<Entity>, object: Entity) -> Event;
operator individual_lift(agent: Entity, object: Entity) -> Event;
operator each_member(group: Group<Entity>, predicate: fn(value: Entity) -> Proposition) -> Proposition;
operator digit(value: Number) -> Digit;
operator repeat_digit(value: Digit, count: Number) -> DigitSequence;
operator multiply(left: Number, right: Number) -> Number;
operator unknown_to(knower: Entity, information: Information) -> Proposition;
operator withheld_by(holder: Entity, information: Information) -> Proposition;
operator utter(act: SpeechAct, content: Proposition) -> Utterance;
operator with_affect(utterance: Utterance, affect: Affect, intensity: Number) -> Utterance;
const speaker: Entity;
const mary: Entity;
const peter: Entity;
const food: Entity;
const home: Entity;
